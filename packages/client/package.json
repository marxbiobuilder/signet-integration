{
  "name": "@xignet/client",
  "version": "0.2.1",
  "description": "Signet machine-to-machine OAuth client with safe errors, token caching and client_secret_basic authentication.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marxbiobuilder/signet-integration.git",
    "directory": "packages/client"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "openid-client": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
