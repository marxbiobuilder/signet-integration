{
  "name": "signet-integration",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.1.1",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm --filter @xignet/core --filter @xignet/client build && pnpm -r lint",
    "typecheck": "pnpm --filter @xignet/core --filter @xignet/client build && pnpm -r typecheck",
    "test": "pnpm --filter @xignet/core --filter @xignet/client build && pnpm -r test",
    "test:cov": "pnpm --filter @xignet/core --filter @xignet/client build && pnpm -r test:cov"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "mcp-handler@1.1.0>@modelcontextprotocol/sdk": "1.30.0"
      }
    }
  }
}
